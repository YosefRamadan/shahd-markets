# Supabase project URL. Public value used by the Vite client and SSR bundle.
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Supabase project ref/id, used by generated Lovable/Supabase metadata.
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# Supabase anon/publishable key. Public key used by browser auth and RLS queries.
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-or-publishable-key"

# Runtime Supabase URL binding for Cloudflare server functions.
SUPABASE_URL="https://your-project.supabase.co"

# Runtime Supabase anon/publishable key for Cloudflare server functions that validate user JWTs.
SUPABASE_PUBLISHABLE_KEY="your-supabase-anon-or-publishable-key"

# Runtime Supabase service-role key for trusted server-side admin operations.
# NEVER expose this as a VITE_ variable and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
